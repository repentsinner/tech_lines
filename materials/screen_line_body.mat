// Body pass of the screen-space line: the fully covered fragments of an
// opaque line. It draws in the opaque pass and writes rasterized depth, so
// lines and meshes occlude each other with no sorting. Every other
// fragment belongs to screen_line_edge.mat.

material {
    name : ScreenLineBody,

    // Shared by both passes; the Dart side sets every one of them.
    parameters : [
        { type : float4, name : lineColor, precision : high },
        { type : float, name : opacity },
        { type : float, name : vertexColorMix },
        { type : float, name : pixelScale, precision : high },
        { type : float, name : rampScale, precision : high },
        { type : float, name : widthReferenceDepth, precision : high },
        { type : int, name : capStyle },
        { type : float, name : depthBias, precision : high },
        { type : float, name : depthSlopeBias, precision : high },
        { type : float2, name : dash, precision : high },
        { type : float, name : progressCursor, precision : high },
        { type : float, name : progressWindowEnd, precision : high },
        { type : float, name : progressDim },
        { type : float, name : progressBoost },
        { type : bool, name : edgeDrawsAll },
        { type : float, name : pulseCenter, precision : high },
        { type : float, name : pulseHalfLength, precision : high },
        { type : float4, name : pulseColor },
        { type : float, name : pulseOpacity },
        { type : float, name : pulseWidthScale },
        { type : float, name : pulseGlowPixels },
        { type : float2, name : pulseFade }
    ],

    variables : [
        lineFrame,
        lineShape,
        lineProgress
    ],

    requires : [ position, uv0, uv1, custom0, color ],

    shadingModel : unlit,
    blending : opaque,
    depthWrite : true,
    depthCulling : true,
    culling : none,
    flipUV : false,
    vertexDomain : object,

    variantFilter : [
        skinning, shadowReceiver, vsm, directionalLighting, fog, ssr, stereo
    ]
}

vertex {
    #include "screen_line_vertex.vs"

    void materialVertex(inout MaterialVertexInputs material) {
        screenLineVertex(material);
    }
}

fragment {
    #include "screen_line_fragment.fs"
    #include "screen_line_style.fs"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float band = screenLineBand();
        ScreenLineStyle style = screenLineStyled(band);
        if (screenLineCoverage(band) * style.alpha < SCREEN_LINE_FULL_COVERAGE) {
            discard;
        }
        material.baseColor = vec4(style.rgb, 1.0);
    }
}
